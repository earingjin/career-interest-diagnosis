{
  "version": "1.0.0",
  "general": [
    {
      "id": "g01",
      "part": 1,
      "type": "R",
      "order": 1,
      "text": "스스로 조립하거나 만들 수 있는 제품을 즐겨 산다"
    },
    {
      "id": "g02",
      "part": 1,
      "type": "R",
      "order": 2,
      "text": "자동차 정비공의 일이 재미있을 것 같다"
    },
    {
      "id": "g03",
      "part": 1,
      "type": "R",
      "order": 3,
      "text": "연장을 사용하여 일하는 것을 좋아한다"
    },
    {
      "id": "g04",
      "part": 1,
      "type": "R",
      "order": 4,
      "text": "고칠 수 있는가를 실험해보려고 자주 물건을 분해한다"
    },
    {
      "id": "g05",
      "part": 1,
      "type": "R",
      "order": 5,
      "text": "손을 사용하여 무엇인가를 만드는 일이 즐겁다"
    },
    {
      "id": "g06",
      "part": 1,
      "type": "R",
      "order": 6,
      "text": "사무실 안에서 일하는 것보다 바깥에서 일하는 것이 낫다"
    },
    {
      "id": "g07",
      "part": 1,
      "type": "R",
      "order": 7,
      "text": "도구를 사용하여 무엇을 잘 만드는 편이다"
    },
    {
      "id": "g08",
      "part": 1,
      "type": "I",
      "order": 8,
      "text": "사물에 대해 철저히 이해하기를 좋아한다"
    },
    {
      "id": "g09",
      "part": 1,
      "type": "I",
      "order": 9,
      "text": "논리적으로 생각하고 분석하는 편이다"
    },
    {
      "id": "g10",
      "part": 1,
      "type": "I",
      "order": 10,
      "text": "시험에서 틀린 문제에 끝까지 정답을 밝혀낸다"
    },
    {
      "id": "g11",
      "part": 1,
      "type": "I",
      "order": 11,
      "text": "지적인 토론이 이루어지는 대화를 좋아한다"
    },
    {
      "id": "g12",
      "part": 1,
      "type": "I",
      "order": 12,
      "text": "여러 가지 자연현상에 대해 호기심을 갖고 있다"
    },
    {
      "id": "g13",
      "part": 1,
      "type": "I",
      "order": 13,
      "text": "소프트웨어 성능을 비교, 분석한다"
    },
    {
      "id": "g14",
      "part": 1,
      "type": "I",
      "order": 14,
      "text": "난이도가 높은 문제 풀이에 도전하는 것을 좋아한다"
    },
    {
      "id": "g15",
      "part": 1,
      "type": "A",
      "order": 15,
      "text": "끊임없이 美(아름다움)을 추구한다"
    },
    {
      "id": "g16",
      "part": 1,
      "type": "A",
      "order": 16,
      "text": "새로운 색이나 디자인의 옷을 남다르게 입는 것을 좋아한다"
    },
    {
      "id": "g17",
      "part": 1,
      "type": "A",
      "order": 17,
      "text": "감정표현이 풍부하다"
    },
    {
      "id": "g18",
      "part": 1,
      "type": "A",
      "order": 18,
      "text": "아름다운 음악이나 그림에 감명을 받는 경우가 많다"
    },
    {
      "id": "g19",
      "part": 1,
      "type": "A",
      "order": 19,
      "text": "평소 제품의 디자인을 눈여겨 보는 편이다"
    },
    {
      "id": "g20",
      "part": 1,
      "type": "A",
      "order": 20,
      "text": "예술은 우리의 삶을 풍요롭게 한다고 생각한다"
    },
    {
      "id": "g21",
      "part": 1,
      "type": "A",
      "order": 21,
      "text": "예술 작품을 음미할 줄 안다"
    },
    {
      "id": "g22",
      "part": 1,
      "type": "S",
      "order": 22,
      "text": "어려움에 처한 사람들을 이해하고 도와주려고 애쓴다"
    },
    {
      "id": "g23",
      "part": 1,
      "type": "S",
      "order": 23,
      "text": "불우한 이웃을 돕는데 더 많은 관심을 가져야 한다"
    },
    {
      "id": "g24",
      "part": 1,
      "type": "S",
      "order": 24,
      "text": "사람들의 개인적인 이야기를 잘 들어주는 편이다"
    },
    {
      "id": "g25",
      "part": 1,
      "type": "S",
      "order": 25,
      "text": "남에게 도움을 주는 직업을 택하고 싶다"
    },
    {
      "id": "g26",
      "part": 1,
      "type": "S",
      "order": 26,
      "text": "다른 사람들에게 위기가 닥쳤을 때 돕기는 자처한다"
    },
    {
      "id": "g27",
      "part": 1,
      "type": "S",
      "order": 27,
      "text": "사람들의 고민을 잘 들어주는 편이다"
    },
    {
      "id": "g28",
      "part": 1,
      "type": "S",
      "order": 28,
      "text": "타인 입장에서 생각하는 편이다"
    },
    {
      "id": "g29",
      "part": 1,
      "type": "E",
      "order": 29,
      "text": "규모가 큰 프로젝트를 따내는 일을 하고 싶다"
    },
    {
      "id": "g30",
      "part": 1,
      "type": "E",
      "order": 30,
      "text": "집단의 지도자가 되는 것은 도전해 볼 만한 일이다"
    },
    {
      "id": "g31",
      "part": 1,
      "type": "E",
      "order": 31,
      "text": "야망이 큰 편이다"
    },
    {
      "id": "g32",
      "part": 1,
      "type": "E",
      "order": 32,
      "text": "조직의 높은 위치에서 다른 사람을 이끌고 싶다"
    },
    {
      "id": "g33",
      "part": 1,
      "type": "E",
      "order": 33,
      "text": "어떤 분야에서 주도적으로 일을 하는 편이다"
    },
    {
      "id": "g34",
      "part": 1,
      "type": "E",
      "order": 34,
      "text": "사회적 지위획득에 관심이 많다"
    },
    {
      "id": "g35",
      "part": 1,
      "type": "E",
      "order": 35,
      "text": "남에게 지는 것을 싫어한다"
    },
    {
      "id": "g36",
      "part": 1,
      "type": "C",
      "order": 36,
      "text": "원리원칙대로 행동한다"
    },
    {
      "id": "g37",
      "part": 1,
      "type": "C",
      "order": 37,
      "text": "신중하고 완벽하게 일을 처리해야 만족감을 느낀다"
    },
    {
      "id": "g38",
      "part": 1,
      "type": "C",
      "order": 38,
      "text": "하루 일과가 잘 짜여져 있을 때 안정감을 느낀다"
    },
    {
      "id": "g39",
      "part": 1,
      "type": "C",
      "order": 39,
      "text": "꼼꼼하게 일을 처리해야 만족감을 느낀다"
    },
    {
      "id": "g40",
      "part": 1,
      "type": "C",
      "order": 40,
      "text": "정해진 규칙대로 일하지 않으면 불안하다"
    },
    {
      "id": "g41",
      "part": 1,
      "type": "C",
      "order": 41,
      "text": "쉽게 찾을 수 있도록 물건을 정리하는 편이다"
    },
    {
      "id": "g42",
      "part": 1,
      "type": "C",
      "order": 42,
      "text": "반복적인 일을 잘 처리한다"
    }
  ],
