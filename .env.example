NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_HASH_SECRET=

# 개발 중 다른 주소(예: 휴대폰 접속 http://192.168.0.10:3000)에서 POST 를 허용할 origin 목록. 쉼표로 구분, 정확히 일치만 허용(와일드카드 불가). 비우면 같은 origin 만 허용.
ALLOWED_ORIGINS=

# 관리자 로그인 (서버 전용, 고객용 SESSION_HASH_SECRET 과 별개 값을 쓴다). 설정 방법은 README 의 "관리자 계정 설정" 참고.
# 세 값 중 하나라도 비어 있거나 올바르지 않으면 관리자 영역은 모두 접근이 거부된다.
ADMIN_ID=
# node scripts/hash-admin-password.mjs 로 만든 한 줄 (scrypt:... 형식). 비밀번호 원문을 적지 않는다.
ADMIN_PASSWORD_HASH=
# 32자 이상 무작위 문자열. 바꾸면 로그인된 관리자 세션이 모두 끝난다.
ADMIN_SESSION_SECRET=
